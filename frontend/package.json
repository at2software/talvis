{
  "name": "TALVIS",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "ng": "ng",
    "start": "npm run generate:models && ng serve",
    "build": "npm run generate:models && ng build",
    "build:i18n": "npm run generate:models && ng build --localize --configuration=production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "extract-and-translate": "ng extract-i18n && python translate.py",
    "generate:models": "node scripts/generate-model-registry.js",
    "lint": "ng lint",
    "analyze": "ng build --configuration=production --stats-json && esbuild-visualizer --metadata dist/talvis/stats.json --filename dist/talvis/stats.html"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/localize": "^22.0.8",
    "@angular/platform-browser": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.3",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.12",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "keycloak-angular": "^22.0.0",
    "keycloak-js": "^26.2.1",
    "laravel-echo": "^2.2.7",
    "leaflet": "^1.9.4",
    "material-icons": "^1.13.1",
    "ngx-color-picker": "^20.1.1",
    "ngx-daterangepicker-material": "^6.0.4",
    "ngx-echarts": "^22.0.0",
    "ngx-quill": "^31.0.1",
    "ngx-scrollbar": "^19.1.5",
    "node-forge": "^1.4.0",
    "pusher-js": "^8.4.0",
    "quill": "2.0.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.15.3",
    "@types/node-forge": "^1.3.14",
    "@types/tinycolor2": "^1.4.3",
    "angular-eslint": "22.1.0",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^29.1.1",
    "tinycolor2": "^1.6.0",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "quill": "2.0.2",
    "uuid": "^11.1.1",
    "@hono/node-server": "^2.0.5"
  }
}
